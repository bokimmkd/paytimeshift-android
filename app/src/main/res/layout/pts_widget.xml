<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
 <ImageView android:id="@+id/widget_logo" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_logo" android:contentDescription="@string/app_name"/>
 <TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/widget_brand" android:textStyle="bold" android:textSize="14sp" android:textColor="#071C43"/>
 <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="@string/widget_title" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#586877"/>
</LinearLayout>
<LinearLayout android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:padding="8dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_panel">
  <TextView android:id="@+id/widget_today_label" android:text="@string/widget_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00857C" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
  <LinearLayout android:id="@+id/widget_today_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><include layout="@layout/pts_widget_empty"/></LinearLayout>
  <TextView android:id="@+id/widget_today_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#00857C" android:visibility="gone"/></LinearLayout>
<LinearLayout android:id="@+id/widget_tomorrow" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:padding="8dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_panel">
  <TextView android:id="@+id/widget_tomorrow_label" android:text="@string/widget_tomorrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00857C" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
  <LinearLayout android:id="@+id/widget_tomorrow_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><include layout="@layout/pts_widget_empty"/></LinearLayout>
  <TextView android:id="@+id/widget_tomorrow_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#00857C" android:visibility="gone"/></LinearLayout>
</LinearLayout>
